@model ProjectBuildCraft.ViewModels.BuildViewModel
@using ProjectBuildCraft.Models

<h1>Generate Your Destiny Build</h1>

<form asp-action="Index" method="post">
  <!-- CLASS grid -->
  <div class="class-grid">
    @foreach (var cls in Model.Classes)
    {
      <label class="class-option">
        <input asp-for="SelectedClassId" type="radio" hidden value="@cls.Id" />
        <img src="@cls.ImageUrl" alt="@cls.Name" title="@cls.Name" />
        <div class="caption">@cls.Name</div>
      </label>
    }
  </div>

  <!-- SUBCLASS image-grid & ARMOR dropdown -->
  <div id="subclassArmorPanel" style="display:none; margin-top:1rem;">
    <h3>Pick Your Subclass</h3>
    <div class="subclass-grid" id="subclassGrid"></div>

    <div class="form-group mt-3">
      <label asp-for="SelectedArmorId">Exotic Armor</label>
      <select id="armorSelect"
              asp-for="SelectedArmorId"
              class="form-control"
              disabled>
        <option value="">-- pick armor --</option>
      </select>
    </div>
  </div>

  <!-- WEAPON dropdown -->
<div class="form-group mt-3">
  <label asp-for="SelectedWeaponHash">Exotic Weapon</label>
  <select asp-for="SelectedWeaponHash"
          asp-items="Model.Weapons"
          class="form-control">
    <option value="">-- select weapon --</option>
  </select>
  <span asp-validation-for="SelectedWeaponHash" class="text-danger"></span>
</div>



  <!-- FOCUS dropdown -->
  <div class="form-group mt-3">
    <label asp-for="SelectedFocusId">Build Focus</label>
    <select asp-for="SelectedFocusId"
            asp-items="Model.FocusOptions"
            class="form-control">
      <option value="">-- select focus --</option>
    </select>
  </div>

  <!-- ABILITY CHARGE dropdown -->
  <div class="form-group mt-3">
    <label asp-for="SelectedChargeTypeId">Ability Focus</label>
    <select asp-for="SelectedChargeTypeId"
            asp-items="Model.ChargeTypes"
            class="form-control">
      <option value="">-- select focus --</option>
    </select>
  </div>

  <button type="submit" class="btn btn-primary mt-4">
    Generate Build!
  </button>
</form>

@if (Model.Recommendation != null && Model.ModLoadout.Any())
{
    <hr class="my-4" />
    
    <h4>Suggested Mod Loadout</h4>
    <div class="mod-loadout-section">
        <table class="table">
      <thead>
        <tr>
          <th>Slot</th>
          <th>Mod</th>
        </tr>
      </thead>
      <tbody>
        @{
          // safely pull out each list
          var aspects = Model.AspectLoadout.TryGetValue("Aspects", out var aList) 
                            ? aList 
                            : new List<Aspect>();
          var fragments = Model.FragmentLoadout.TryGetValue("Fragments", out var fList) 
                            ? fList 
                            : new List<Fragment>();
          var mods = Model.ModLoadout;
          List<ModDef> helmetMods = mods.ContainsKey("Helmet")   ? mods["Helmet"]   : new();
          List<ModDef> glovesMods = mods.ContainsKey("Arms")     ? mods["Arms"]     : new();
          List<ModDef> chestMods  = mods.ContainsKey("Chest")    ? mods["Chest"]    : new();
          List<ModDef> legsMods   = mods.ContainsKey("Legs")     ? mods["Legs"]     : new();
          List<ModDef> classMods  = mods.ContainsKey("ClassItem")? mods["ClassItem"]: new();
        }
        <tr>
          <td>Aspects</td>
          <td>@string.Join(", ", aspects.Select(a => a.Name))</td>
        </tr>
        <tr>
          <td>Fragments</td>
          <td>@string.Join(", ", fragments.Select(f => f.Name))</td>
        </tr>
        <tr>
          <td>Helmet</td>
          <td>@string.Join(", ", helmetMods.Select(m => m.Name))</td>
        </tr>
        <tr>
          <td>Gloves</td>
          <td>@string.Join(", ", glovesMods.Select(m => m.Name))</td>
        </tr>
        <tr>
          <td>Chest</td>
          <td>@string.Join(", ", chestMods.Select(m => m.Name))</td>
        </tr>
        <tr>
          <td>Legs</td>
          <td>@string.Join(", ", legsMods.Select(m => m.Name))</td>
        </tr>
        <tr>
          <td>Class Item</td>
          <td>@string.Join(", ", classMods.Select(m => m.Name))</td>
        </tr>
      </tbody>
    </table>
      </div>
}


@section Scripts {
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const classInputs  = document.querySelectorAll('input[name="SelectedClassId"]');
      const panel        = document.getElementById('subclassArmorPanel');
      const subclassGrid = document.getElementById('subclassGrid');
      const armorSelect  = document.getElementById('armorSelect');
      let preSubId       = '@(Model.SelectedSubclassId?.ToString() ?? "")';
      let preArmId       = '@(Model.SelectedArmorId?.ToString() ?? "")';

      async function loadDependents() {
        const sel     = document.querySelector('input[name="SelectedClassId"]:checked');
        const classId = sel ? sel.value : "";
        if (!classId) {
          panel.style.display    = 'none';
          subclassGrid.innerHTML = '';
          armorSelect.disabled   = true;
          return;
        }

        panel.style.display   = 'block';
        armorSelect.disabled  = false;

        // Fetch & render subclasses
        const subs = await fetch(`/Build/GetSubclasses?classId=${classId}`)
                          .then(r => r.json());
        subclassGrid.innerHTML = '';
        subs.forEach(s => {
          subclassGrid.innerHTML += `
            <label class="subclass-option">
              <input type="radio" name="SelectedSubclassId" hidden value="${s.id}" />
              <img src="${s.imageUrl}" alt="${s.name}" title="${s.name}" />
              <div class="caption">${s.name}</div>
            </label>`;
        });
        if (preSubId) {
          const pre = subclassGrid.querySelector(`input[value="${preSubId}"]`);
          if (pre) pre.checked = true;
        }

        // Fetch & populate armor dropdown
        const arms = await fetch(`/Build/GetArmors?classId=${classId}`)
                          .then(r => r.json());
        armorSelect.innerHTML = `<option value="">-- pick armor --</option>`;
        arms.forEach(a => {
          armorSelect.innerHTML += `<option value="${a.id}">${a.name}</option>`;
        });
        if (preArmId) armorSelect.value = preArmId;
      }

      classInputs.forEach(i =>
        i.addEventListener('change', () => {
          preSubId = preArmId = '';
          loadDependents();
        })
      );

      // initial load (handles post-back)
      loadDependents();
    });
  </script>
}
